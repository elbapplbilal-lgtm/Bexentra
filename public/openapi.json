            "required": true,
            "description": "BNB transaction hash or Solana signature.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "height",
            "in": "query",
            "required": false,
            "description": "BNB observed block height hint; validated against block contents.",
