  "components": {
    "parameters": {
      "chain": {
        "name": "chain",
        "in": "query",
        "description": "Supported chain (default bnb).",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "bnb",
            "solana"
          ],
          "default": "bnb"
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Number of records, default 8.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 8
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
