    "/address": {
      "get": {
        "summary": "Indexed wallet activity",
        "description": "Saved transaction history for an address. Pagination uses before_height and before_hash together. This endpoint does not guarantee complete chain history.",
        "tags": [
          "Indexed records"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/chain"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "name": "address",
            "in": "query",
            "required": true,
            "description": "Address for selected chain.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before_height",
            "in": "query",
            "required": false,
            "description": "Pagination cursor block height; supply both together.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "before_hash",
            "in": "query",
            "required": false,
            "description": "Pagination cursor transaction hash; supply both together.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON result with route-specific data and available source/coverage metadata.",
